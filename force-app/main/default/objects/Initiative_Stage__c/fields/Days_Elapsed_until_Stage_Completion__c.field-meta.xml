<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Elapsed_until_Stage_Completion__c</fullName>
    <externalId>false</externalId>
    <formula>Total_Days__c   -  

IF(
AND(
NOT(ISBLANK(Resume_Date__c)), 
NOT(ISBLANK(On_Hold_Date__c))), Resume_Date__c - On_Hold_Date__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Elapsed until Stage Completion</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
