<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_Date_Range</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(AND(Start_Date__c &gt;= Initiative__r.Start_Date__c, Start_Date__c &lt;= Initiative__r.End_Date__c))</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>Start Date must be inside the range of the Start and End Date from the Initiative</errorMessage>
</ValidationRule>
