<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date_Range</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(AND(End_Date__c &gt;= Initiative__r.Start_Date__c, End_Date__c &lt;= Initiative__r.End_Date__c))</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>End Date must be inside the range of the End and Start Date from the Initiative</errorMessage>
</ValidationRule>
