                </rightValue>
            </conditions>
            <connector>
                <targetReference>Run_Business_Pillar_Annual_Cloning</targetReference>
            </connector>
            <label>Yes, it&apos;s Aug 31st</label>
        </rules>
    </decisions>
    <description>Runs daily as it can&apos;t run monthly or yearly. Checks every day if today&apos;s date is Jan 1st and then it runs subflows for logic handling.</description>
