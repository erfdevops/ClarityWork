    <formulas>
        <name>fCurrentAccuracyLevel</name>
        <dataType>Number</dataType>
        <expression>{!vSumOfPercentages}/{!vAllChildStagesCount}*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fSLAAchievement</name>
        <dataType>Number</dataType>
        <expression>IF(
AND(
NOT(ISBLANK({!Loop_Stages_to_set_Counts.Smart_Goal_in_Days__c} )),
{!Loop_Stages_to_set_Counts.Requires_Approval__c} = FALSE),
IF(
{!Loop_Stages_to_set_Counts.Smart_Goal_in_Days__c} &lt;= 0,
NULL,
MIN(
1,
MAX(
0.6,
IF(
BLANKVALUE({!Loop_Stages_to_set_Counts.Business_Days_Since_Start_Date__c}, 0) &lt;= 0,
1, /* same-day or not started → 100% */
{!Loop_Stages_to_set_Counts.Smart_Goal_in_Days__c} / {!Loop_Stages_to_set_Counts.Business_Days_Since_Start_Date__c}
)
)
)
)
,NULL)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fSLAAchievement2</name>
        <dataType>Number</dataType>
        <expression>IF(
AND(
NOT(ISBLANK({!Loop_Stages.Smart_Goal_in_Days__c} )),
{!Loop_Stages.Requires_Approval__c} = FALSE),
IF(
{!Loop_Stages.Smart_Goal_in_Days__c} &lt;= 0,
NULL,
MIN(
1,
MAX(
0.6,
IF(
BLANKVALUE({!Loop_Stages.Business_Days_Since_Start_Date__c}, 0) &lt;= 0,
1, /* same-day or not started → 100% */
{!Loop_Stages.Smart_Goal_in_Days__c} / {!Loop_Stages.Business_Days_Since_Start_Date__c}
)
)
)
)
,NULL)</expression>
        <scale>2</scale>
    </formulas>
