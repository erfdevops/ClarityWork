    <formulas>
        <name>AnnualPlanName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Employees.Name} &amp; &quot; | &quot; &amp; {!FY_Label}</expression>
    </formulas>
    <formulas>
        <name>frm_BaseURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_540}) - 1)</expression>
    </formulas>
    <formulas>
        <name>frm_IsNewManager</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
  CONTAINS(
    &quot;;&quot; &amp; TRIM({!txt_ManagerIdBag}) &amp; &quot;;&quot;,
    &quot;;&quot; &amp; {!Loop_New_APs.Manager__c} &amp; &quot;;&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>frm_ManagerListViewLink</name>
        <dataType>String</dataType>
        <expression>{!frm_BaseURL} &amp; &quot;/lightning/o/Annual_Plan__c/list?filterName=&quot; &amp; 
SUBSTITUTE({!Get_Manager_User.Name}, &quot; &quot;, &quot;_&quot;) &amp; &quot;_Manager_View&quot;</expression>
    </formulas>
    <formulas>
        <name>frm_UpdateManagerBag</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN(TRIM({!txt_ManagerIdBag})) &gt; 0,
  TRIM({!txt_ManagerIdBag}) &amp; &quot;;&quot; &amp; {!Loop_New_APs.Manager__c},
  {!Loop_New_APs.Manager__c}
)</expression>
    </formulas>
    <formulas>
        <name>FY_Label</name>
        <dataType>String</dataType>
        <expression>IF(
  MONTH($Flow.CurrentDate) &gt;= 9,
  &quot;October &quot; &amp; TEXT(YEAR($Flow.CurrentDate)) &amp; &quot; - September &quot; &amp; TEXT(YEAR($Flow.CurrentDate) + 1),
  &quot;October &quot; &amp; TEXT(YEAR($Flow.CurrentDate) - 1) &amp; &quot; - September &quot; &amp; TEXT(YEAR($Flow.CurrentDate))
)</expression>
    </formulas>
    <formulas>
        <name>IsFirstWorkingDayOfSeptember</name>
        <dataType>Boolean</dataType>
        <expression>$Flow.CurrentDate = 
CASE(
  WEEKDAY( DATE( YEAR($Flow.CurrentDate), 9, 1 ) ),
  1, DATE( YEAR($Flow.CurrentDate), 9, 2 ),  /* Sunday → Monday 2nd */
  7, DATE( YEAR($Flow.CurrentDate), 9, 3 ),  /* Saturday → Monday 3rd */
     DATE( YEAR($Flow.CurrentDate), 9, 1 )   /* Else → Sept 1 */
)</expression>
    </formulas>
    <formulas>
        <name>IsOctoberFirst</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  MONTH($Flow.CurrentDate) = 10,
  DAY($Flow.CurrentDate) = 1
)</expression>
    </formulas>
    <formulas>
        <name>TestBoolean</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  /* TEMP: fire on your test days */
  $Flow.CurrentDate = DATE(2025, 10, 1),
  $Flow.CurrentDate = DATE(2025, 11, 12),

  /* PROD: fire on the first working day of September */
  $Flow.CurrentDate =
    CASE(
      WEEKDAY( DATE( YEAR($Flow.CurrentDate), 9, 1 ) ),
      1, DATE( YEAR($Flow.CurrentDate), 9, 2 ),  /* if Sep 1 is Sun → Sep 2 */
      7, DATE( YEAR($Flow.CurrentDate), 9, 3 ),  /* if Sep 1 is Sat → Sep 3 */
         DATE( YEAR($Flow.CurrentDate), 9, 1 )   /* else → Sep 1 */
    )
)</expression>
    </formulas>
