    <description>Takes a recently created Initiative Stage and pulls its parent&apos;s Tasks to clone them and have those clones related to the newly created Initiative Stage record.</description>
    <environments>Default</environments>
    <formulas>
        <name>fFiscalYear</name>
        <dataType>String</dataType>
        <expression>&quot;October &quot;+TEXT(YEAR(TODAY()))+&quot; - September &quot;+TEXT(YEAR(TODAY())+1)</expression>
    </formulas>
    <formulas>
        <name>fNewInitiativeName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Initiatives_Stage_Tasks_to_Clone_Them.Name}+&quot; - &quot;+TEXT(YEAR(TODAY()))</expression>
    </formulas>
