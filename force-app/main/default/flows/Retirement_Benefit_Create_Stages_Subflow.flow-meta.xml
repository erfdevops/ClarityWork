    <formulas>
        <name>fEndOfMonthDate</name>
        <dataType>Date</dataType>
        <expression>/* Get the last calendar day of this month */
IF(
    /* If last day is Saturday */
    CASE(
        WEEKDAY(
            DATE(
                YEAR(TODAY()),
                MONTH(TODAY()) + 1,
                1
            ) - 1
        ),
        1, &quot;Sun&quot;,
        2, &quot;Mon&quot;,
        3, &quot;Tue&quot;,
        4, &quot;Wed&quot;,
        5, &quot;Thu&quot;,
        6, &quot;Fri&quot;,
        7, &quot;Sat&quot;,
        &quot;&quot;
    ) = &quot;Sat&quot;,
    /* Then last business day is that date minus 1 day (Friday) */
    (DATE(
        YEAR(TODAY()),
        MONTH(TODAY()) + 1,
        1
    ) - 1) - 1,

    /* else if last day is Sunday */
    IF(
        CASE(
            WEEKDAY(
                DATE(
                    YEAR(TODAY()),
                    MONTH(TODAY()) + 1,
                    1
                ) - 1
            ),
            1, &quot;Sun&quot;,
            2, &quot;Mon&quot;,
            3, &quot;Tue&quot;,
            4, &quot;Wed&quot;,
            5, &quot;Thu&quot;,
            6, &quot;Fri&quot;,
            7, &quot;Sat&quot;,
            &quot;&quot;
        ) = &quot;Sun&quot;,
        /* Then last business day is that date minus 2 days (Friday) */
        (DATE(
            YEAR(TODAY()),
            MONTH(TODAY()) + 1,
            1
        ) - 1) - 2,

        /* else it&apos;s already a weekday, just use it */
        DATE(
            YEAR(TODAY()),
            MONTH(TODAY()) + 1,
            1
        ) - 1
    )
)</expression>
    </formulas>
