    <description>Takes the newly created Business Pillar and pulls all the Initiatives from the parent Pillar to have them cloned and relates those clones to the newly created Business Pillar.</description>
    <environments>Default</environments>
    <formulas>
        <name>fFiscalYear</name>
        <dataType>String</dataType>
        <expression>&quot;October &quot;+TEXT(YEAR(TODAY()))+&quot; - September &quot;+TEXT(YEAR(TODAY())+1)</expression>
    </formulas>
    <formulas>
        <name>fNewInitiativeName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Initiatives_to_Clone_Them.Name}+&quot; - &quot;+TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <interviewLabel>Cloning - Clone Pillar Initiatives {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cloning - Clone Pillar Initiatives</label>
    <loops>
        <name>Loop_Initiatives_to_Clone_Them</name>
        <label>Loop Initiatives to Clone Them</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <collectionReference>Get_Parent_Pillar_s_Initiatives</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Up_New_Initiative_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_New_Initiatives</targetReference>
        </noMoreValuesConnector>
    </loops>
