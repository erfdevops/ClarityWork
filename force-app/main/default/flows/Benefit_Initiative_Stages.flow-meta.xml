<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Add_to_Collection_to_Update</name>
        <label>Add to Collection to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>socInitiativeStagesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>soUpdatedInitiativeStage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Clear_Variable</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Clear_Variable</name>
        <label>Clear Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>soUpdatedInitiativeStage</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Initiative_Stages</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_of_Initiatives_Found</name>
        <label>Count of Initiatives Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vInitiativeStageCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_All_Benefit_Related_Initiative_Stages</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Count_Higher_than_Zero</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Day_Number</name>
        <label>Store Day Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vDayNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fDayNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vMonthFirst3letters</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fMonths3FirstLetters</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_1st_of_Month</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Values</name>
        <label>Update Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>soUpdatedInitiativeStage.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Initiative_Stages.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>soUpdatedInitiativeStage.Approval_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Auto-Approved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>soUpdatedInitiativeStage.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection_to_Update</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_1st_of_Month</name>
        <label>Is 1st of Month?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_1st_of_the_Month</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vDayNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_Benefit_Related_Initiative_Stages</targetReference>
            </connector>
            <label>Yes, 1st of the Month</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Count_Higher_than_Zero</name>
        <label>Is Count Higher than Zero?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_there_s_at_least_1_to_update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vInitiativeStageCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Initiative_Stages</targetReference>
            </connector>
            <label>Yes, there&apos;s at least 1 to update</label>
        </rules>
    </decisions>
    <description>Runs daily however, it only processes the actions on the 1st of every month,</description>
    <environments>Default</environments>
    <formulas>
        <name>fDayNumber</name>
        <dataType>Number</dataType>
        <expression>DAY(TODAY())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fMonths3FirstLetters</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH(TODAY())-1,
1, &quot;Jan&quot;,
2, &quot;Feb&quot;,
3, &quot;Mar&quot;,
4, &quot;Apr&quot;,
5, &quot;May&quot;,
6, &quot;Jun&quot;,
7, &quot;Jul&quot;,
8, &quot;Aug&quot;,
9, &quot;Sep&quot;,
10, &quot;Oct&quot;,
11, &quot;Nov&quot;,
12, &quot;Dec&quot;, NULL)+&quot; &quot;+TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <interviewLabel>Benefit Initiative Stages {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Benefit Initiative Stages</label>
    <loops>
        <name>Loop_Initiative_Stages</name>
        <label>Loop Initiative Stages</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Benefit_Related_Initiative_Stages</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Initiative_Stages</targetReference>
        </noMoreValuesConnector>
    </loops>
