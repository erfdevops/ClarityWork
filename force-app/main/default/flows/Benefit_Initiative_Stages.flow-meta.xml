    <recordLookups>
        <name>Get_All_Benefit_Related_Initiative_Stages</name>
        <label>Get All Benefit Related Initiative Stages</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
