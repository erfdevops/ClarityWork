        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Initiative_Stage_Hierarchy__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Child Stage</stringValue>
            </value>
        </filters>
        <filters>
            <field>Business_Pillar__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Benefits</stringValue>
            </value>
        </filters>
        <filters>
            <field>Benefit__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>vMonthFirst3letters</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Initiative_Stage__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
