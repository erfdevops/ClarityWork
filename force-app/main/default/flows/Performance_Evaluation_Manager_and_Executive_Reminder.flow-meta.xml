<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Assign_Manager_Emails</name>
        <label>Assign Manager Emails</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEmailLower</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fManagerEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Manager_Email_Exists</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Manager_Already_Added</name>
        <label>Manager Already Added?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_PEs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Added</defaultConnectorLabel>
        <rules>
            <name>Already_Added</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isManagerAlreadyInSet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_PEs</targetReference>
            </connector>
            <label>Already Added</label>
        </rules>
    </decisions>
    <decisions>
        <name>Manager_Email_Exists</name>
        <label>Manager Email Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_PEs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Yes_Manager_Has_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEmailLower</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Manager_Already_Added</targetReference>
            </connector>
            <label>Yes Manager Has Email</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fEnd</name>
        <dataType>Date</dataType>
        <expression>$Flow.CurrentDate - 2</expression>
    </formulas>
    <formulas>
        <name>fManagerEmail</name>
        <dataType>String</dataType>
        <expression>LOWER({!Loop_PEs.Manager__r.Email})</expression>
    </formulas>
    <formulas>
        <name>fStart</name>
        <dataType>Date</dataType>
        <expression>$Flow.CurrentDate - 3</expression>
    </formulas>
    <formulas>
        <name>isManagerAlreadyInSet</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(
  &quot;|&quot; &amp; {!varEmailsCSV} &amp; &quot;|&quot;,
  &quot;|&quot; &amp; {!varEmailLower} &amp; &quot;|&quot;
)</expression>
    </formulas>
    <interviewLabel>Performance Evaluation Manager and Executive Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Performance Evaluation Manager and Executive Reminder</label>
    <loops>
        <name>Loop_PEs</name>
        <label>Loop PEs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Performance_Evaluations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Manager_Emails</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Performance_Evaluations</name>
        <label>Get Performance Evaluations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_PEs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Manager Evaluation</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fStart</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>fEnd</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Performance_Evaluation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Performance_Evaluations</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-11-03</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varEmailLower</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEmailsCSV</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
