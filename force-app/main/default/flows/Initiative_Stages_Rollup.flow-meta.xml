    <decisions>
        <name>Is_2025_2026_Fiscal_Year</name>
        <label>Is 2025 - 2026 Fiscal Year?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Stages</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_it_s_that_fiscal_year</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Initiative__r.Fiscal_Year__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>October 2025 - September 2026</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Stages_January_and_On</targetReference>
            </connector>
            <label>Yes, it&apos;s that fiscal year</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fAccuracyLevel</name>
        <dataType>Number</dataType>
