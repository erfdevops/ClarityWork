    <description>Runs every year and clones all Business Pillar records for the new year.</description>
    <environments>Default</environments>
    <formulas>
        <name>fFiscalYear</name>
        <dataType>String</dataType>
        <expression>&quot;October &quot;+TEXT(YEAR(TODAY()))+&quot; - September &quot;+TEXT(YEAR(TODAY())+1)</expression>
    </formulas>
    <formulas>
        <name>fToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fTodayAYearAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY()-365</expression>
    </formulas>
    <interviewLabel>Cloning - Business Pillar Annual Cloning {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cloning - Business Pillar Annual Cloning</label>
    <loops>
        <name>Loop_Pillars_to_Clone</name>
        <label>Loop Pillars to Clone</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <collectionReference>Get_Business_Pillar_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
