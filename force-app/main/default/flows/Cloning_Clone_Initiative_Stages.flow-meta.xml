    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Insert_New_Initiative_Stages</name>
        <label>Insert New Initiative Stages</label>
        <locationX>50</locationX>
        <locationY>1163</locationY>
        <inputReference>socStagesToInsert</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Parent_Initiative_s_Stages</name>
        <label>Get Parent Initiative&apos;s Stages</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Initiative_Stages_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Initiative__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Parent_Initiative_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Initiative_Stage_Hierarchy__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Child Stage</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Initiative_Stage__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Parent_a_Clone</targetReference>
        </connector>
