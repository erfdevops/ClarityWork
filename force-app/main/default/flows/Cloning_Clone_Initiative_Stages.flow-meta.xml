    <decisions>
        <name>Initiative_Stages_Found</name>
        <label>Initiative Stages Found?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Initiative_Stages_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Initiative_s_Stages</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Up_Fiscal_Year</targetReference>
            </connector>
            <label>Yes, Initiative Stages Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>.</description>
        <name>Is_Parent_a_Clone</name>
        <label>Is Parent a Clone?</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_is_Clone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Initiative_Parent__r.Clone_Record__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Parent_Initiative_s_Stages</targetReference>
            </connector>
            <label>Yes, is Clone</label>
        </rules>
    </decisions>
    <description>Takes a recently created Initiative and queries its parent initiative stages, then clones them and relates those clones to the newly created initiative record.</description>
    <environments>Default</environments>
    <formulas>
        <name>fFiscalYear</name>
        <dataType>String</dataType>
        <expression>&quot;October &quot;+TEXT(YEAR(TODAY()))+&quot; - September &quot;+TEXT(YEAR(TODAY())+1)</expression>
    </formulas>
    <formulas>
        <name>fNewInitiativeName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Initiatives_Stages_to_Clone_Them.Name}+&quot; - &quot;+TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <interviewLabel>Cloning - Clone Initiative Stages {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cloning - Clone Initiative Stages</label>
    <loops>
        <name>Loop_Initiatives_Stages_to_Clone_Them</name>
        <label>Loop Initiatives Stages to Clone Them</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <collectionReference>Get_Parent_Initiative_s_Stages</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Up_New_Initiative_Stage_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_New_Initiative_Stages</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
