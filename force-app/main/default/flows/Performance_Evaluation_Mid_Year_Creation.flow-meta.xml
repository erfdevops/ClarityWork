    <formulas>
        <name>frm_BaseURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_540}) - 1)</expression>
    </formulas>
    <formulas>
        <name>frm_IsNewManager</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
  CONTAINS(
    &quot;;&quot; &amp; TRIM({!txt_ManagerIdBag}) &amp; &quot;;&quot;,
    &quot;;&quot; &amp; {!Loop_New_PEs.Manager__c} &amp; &quot;;&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>frm_ManagerListViewLink</name>
        <dataType>String</dataType>
        <expression>{!frm_BaseURL} &amp; &quot;/lightning/o/Performance_Evaluation__c/list?filterName=&quot; &amp; 
SUBSTITUTE({!Get_Manager_User.Name}, &quot; &quot;, &quot;_&quot;) &amp; &quot;_Manager_View&quot;</expression>
    </formulas>
    <formulas>
        <name>frm_UpdateManagerBag</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN(TRIM({!txt_ManagerIdBag})) &gt; 0,
  TRIM({!txt_ManagerIdBag}) &amp; &quot;;&quot; &amp; {!Loop_New_PEs.Manager__c},
  {!Loop_New_PEs.Manager__c}
)</expression>
    </formulas>
    <formulas>
        <name>FY_Label</name>
        <dataType>String</dataType>
        <expression>IF(
  MONTH($Flow.CurrentDate) &gt;= 9,
  &quot;October &quot; &amp; TEXT(YEAR($Flow.CurrentDate)) &amp; &quot; - September &quot; &amp; TEXT(YEAR($Flow.CurrentDate) + 1),
  &quot;October &quot; &amp; TEXT(YEAR($Flow.CurrentDate) - 1) &amp; &quot; - September &quot; &amp; TEXT(YEAR($Flow.CurrentDate))
)</expression>
    </formulas>
    <formulas>
        <name>IsAprilFirst</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  $Flow.CurrentDate =
  CASE(
    WEEKDAY( DATE( YEAR($Flow.CurrentDate), 4, 1 ) ),
    1, DATE( YEAR($Flow.CurrentDate), 4, 2 ),
    7, DATE( YEAR($Flow.CurrentDate), 4, 3 ),
       DATE( YEAR($Flow.CurrentDate), 4, 1 )
  ),
  $Flow.CurrentDate = DATE(2026, 4, 28)
)</expression>
    </formulas>
    <formulas>
        <name>PerformanceEvaluationName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Employees.Name} &amp; &quot; | &quot; &amp; {!FY_Label}</expression>
    </formulas>
    <formulas>
        <name>TestBoolean</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  /* TEMP: test run override */
  $Flow.CurrentDate = DATE(2025, 10, 1),
  $Flow.CurrentDate = DATE(2025, 10, 2),

  /* PROD: run on first working day of April */
  $Flow.CurrentDate =
    CASE(
      WEEKDAY( DATE( YEAR($Flow.CurrentDate), 4, 1 ) ),
      1, DATE( YEAR($Flow.CurrentDate), 4, 2 ),  /* Sun → Mon Apr 2 */
      7, DATE( YEAR($Flow.CurrentDate), 4, 3 ),  /* Sat → Mon Apr 3 */
         DATE( YEAR($Flow.CurrentDate), 4, 1 )   /* Else → Apr 1 */
    )
)</expression>
    </formulas>
